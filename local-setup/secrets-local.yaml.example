secrets:
  # Optional: set hostname + other params to use an external/managed PostgreSQL instead of the in-cluster one
  # delivery-db:
  #   local:
  #     username: postgres
  #     password: <password>
  #     hostname: <host>        # e.g. host.docker.internal or a managed DB hostname
  #     port: 5432              # optional, defaults to 5432
  #     database: ""            # optional
  github-app:
    github_com:
      api_url: https://api.github.com
      app_id: ...
      mappings:
        - installation_id: ...
          org: ...
      private_key: |
        -----BEGIN RSA PRIVATE KEY-----
        ...
        -----END RSA PRIVATE KEY-----
  oauth-cfg:
    local:
      client_id: Iv...
      client_secret: ...
      api_url: https://api.github.com
      type: github
      name: GitHub
      role_bindings:
        - roles:
            - admin
          subjects:
            - type: github-user
              name: ... (your user name)
            - type: github-app
              name: ... (your app name)
