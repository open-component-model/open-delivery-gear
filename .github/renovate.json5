{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  internalChecksFilter: 'strict',
  minimumReleaseAge: '7 days',
  branchPrefix: 'renovate/',
  gitAuthor: 'odgbot[bot] <319464553+odgbot[bot]@users.noreply.github.com>',
  gitIgnoredAuthors: [
    '319464553+odgbot[bot]@users.noreply.github.com',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  automerge: false,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },
  baseBranchPatterns: [
    'main',
    '/^release-/',
  ],
  packageRules: [
    {
      // The global 7-day minimumReleaseAge applies to lockfile maintenance
      // too, where it delays refreshing the whole lockfile. Skip it for that
      // as it does not work correctly anyways.
      matchDepTypes: ['lockFileMaintenance'],
      minimumReleaseAge: null,
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepNames: [
        'gardener/cc-utils',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
      ],
      versionCompatibility: '^(?<compatibility>v?)(?<version>.+)$',
      versioning: 'semver',
      pinDigests: true,
    },
    {
      matchDepNames: [
        'docker.io/envoyproxy/envoy',
      ],
      versionCompatibility: '^(?<compatibility>distroless-)?(?<version>.+)$',
      versioning: 'semver',
      pinDigests: true,
      minimumReleaseAge: null,
    },
    {
      matchDepNames: [
        'ocm.software/open-delivery-gear/core',
        'ocm.software/open-delivery-gear/observability',
        'ocm.software/open-delivery-gear/ui',
      ],
      ignoreUnstable: false,
      allowedVersions: '/^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$/',
      minimumReleaseAge: null,
      internalChecksFilter: 'none',
      separateMinorPatch: true,
    },
    {
      matchDepNames: [
        'ocm.software/open-delivery-gear/core',
      ],
      sourceUrl: 'https://github.com/open-component-model/odg-core',
    },
    {
      matchDepNames: [
        'ocm.software/open-delivery-gear/observability',
      ],
      sourceUrl: 'https://github.com/open-component-model/odg-observability',
    },
    {
      matchDepNames: [
        'ocm.software/open-delivery-gear/ui',
      ],
      sourceUrl: 'https://github.com/open-component-model/odg-ui',
    },
    {
      matchBaseBranches: [
        '/^release-/',
      ],
      enabled: false,
    },
    {
      matchBaseBranches: [
        '/^release-/',
      ],
      matchFileNames: [
        '.ocm/base-component.yaml',
      ],
      matchDepNames: [
        'ocm.software/open-delivery-gear/core',
        'ocm.software/open-delivery-gear/observability',
        'ocm.software/open-delivery-gear/ui',
      ],
      enabled: true,
    },
    {
      matchBaseBranches: [
        '/^release-/',
      ],
      matchFileNames: [
        '.ocm/base-component.yaml',
      ],
      matchDepNames: [
        'ocm.software/open-delivery-gear/core',
        'ocm.software/open-delivery-gear/observability',
        'ocm.software/open-delivery-gear/ui',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
  ],
  // Fetch OCM component versions from the OCI registry tags list endpoint.
  // The GCP Artifact Registry tags/list response groups tags under manifest
  // digests; the JSON transform flattens them into Renovate's releases format.
  customDatasources: {
    'ocm-gar': {
      defaultRegistryUrlTemplate: 'https://europe-docker.pkg.dev/v2/gardener-project/releases/component-descriptors/{{packageName}}/tags/list',
      format: 'json',
      transformTemplates: [
        '{"releases": $each(manifest, function($v) { $v.tag.{"version": $} })[]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '.github/workflows/renovate.yml',
      ],
      matchStrings: [
        "renovate-version:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'",
      ],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '.ocm/base-component.yaml',
      ],
      matchStrings: [
        'imageReference:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // Bump OCM_VERSION in renovate-sync-ocm.yaml. OCM_SHA256 stays manual —
      // Renovate cannot fetch checksums for arbitrary GitHub release binaries.
      // The workflow's sha256sum check will fail on bump PRs until the checksum
      // is updated; update it manually on the PR branch (it commits as odgbot,
      // which gitIgnoredAuthors already tolerates).
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate-sync-ocm.yaml'],
      matchStrings: [
        "OCM_VERSION:\\s*'(?<currentValue>[^']+)'",
      ],
      depNameTemplate: 'open-component-model/open-component-model',
      datasourceTemplate: 'github-releases',
    },
    {
      // Track OCM componentReferences via the custom ocm-gar datasource, which
      // reads OCI tags from the Artifact Registry tags/list endpoint.
      // NOTE: the matchStrings regex assumes componentName/name/version appear
      // on consecutive lines in that exact order with no blank lines between
      // them. If the field order or formatting in base-component.yaml changes,
      // this match will silently stop working.
      customType: 'regex',
      managerFilePatterns: [
        '.ocm/base-component.yaml',
      ],
      matchStrings: [
        'componentName:\\s*(?<depName>[^\\n]+)\\n\\s+name:[^\\n]+\\n\\s+version:\\s*(?<currentValue>[^\\n]+)',
      ],
      datasourceTemplate: 'custom.ocm-gar',
      versioningTemplate: 'semver',
    },
  ],
}
